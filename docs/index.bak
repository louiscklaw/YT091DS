<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chinese Herbs Learning Modules</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="manifest" href="./manifest.json" />
    <meta name="theme-color" content="#ffffff" />

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        padding: 20px;
      }
      .gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
      }
      .img-box {
        border: 1px solid #ccc;
        padding: 10px;
        border-radius: 8px;
      }
      img {
        width: 300px;
        height: 200px;
        object-fit: cover;
        display: block;
      }
      #status {
        padding: 10px;
        font-weight: bold;
        margin-bottom: 20px;
      }
      .online {
        background-color: #d4edda;
        color: #155724;
      }
      .offline {
        background-color: #f8d7da;
        color: #721c24;
      }
    </style>
  </head>
  <body
    class="bg-light d-flex flex-column min-vh-100 justify-content-center align-items-center"
  >
    <div class="container text-center">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          <div class="card shadow-sm p-4 bg-white rounded-4">
            <h1 class="h3 mb-4 fw-bold text-dark">得閒刨下書:</h1>

            <div class="d-grid gap-3">
              <a
                href="./chapter_2_mc.html"
                class="btn btn-primary btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #686de0"
                >📖 001 - Chapter 2 MC</a
              >
              <a
                href="./chapter_3_mc.html"
                class="btn btn-primary btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #686de0"
                >📖 002 - Chapter 3 MC</a
              >
              <a
                href="./herbs_recognition.html"
                class="btn btn-success btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #22a6b3"
                >📖 003 - 得閒認下藥</a
              >

              <hr />

              <a
                href="https://forms.gle/pTBUZ9wyJ8RAphpGA"
                class="btn btn-success btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #be2edd"
                >❓ 有咩問題 ?</a
              >

              <hr />

              <button
                type="button"
                id="shareBtn"
                class="btn btn-success btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #30336b; border: none"
              >
                🙌 分享
              </button>

              <!--  -->

              <a
                href="https://github.com/louiscklaw/YT091DS"
                class="btn btn-success btn-lg py-3 fw-semibold shadow-sm text-start"
                style="background-color: #30336b"
                target="_blank"
                >🔧 原始碼</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main JavaScript File -->
    <script src="./index.js"></script>
  </body>
</html>
